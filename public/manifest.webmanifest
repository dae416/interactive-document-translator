    {
      "src": "/icons/{{APP_ICON}}-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/{{APP_ICON}}.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
