{
  "name": "interactive-document-translator",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive tool for reading and translating documents: books in one language with help in another, and research papers (a fork of PaperGloss)",
  "keywords": [
    "book-reader",
    "paper-reader",
    "arxiv",
    "pdf",
    "llm",
    "translation",
    "self-hosted",
    "pwa",
    "claude",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.17",
    "katex": "0.18.9",
    "linkedom": "0.18.14",
    "marked": "18.0.14",
    "pdfjs-dist": "6.3.289",
    "undici": "7.30.1"
  }
}
